{
  "Serilog": {
    "MinimumLevel": {
      // Verbose | Debug | Information | Warning | Error | Fatal
      "Default": "Information",
      "Override": {
        "Elders": "Warning",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Information"
      }
    },
    "WriteTo": {
      // Shared emptyDir volume read by the Filebeat sidecar
      "File": {
        "Name": "Async",
        "Args": {
          "bufferSize": 20000,
          "blockWhenFull": false,
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "/var/log/app/%log_name%-.json",
                "formatter": {
                  "type": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
                },
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800,
                "retainedFileCountLimit": 5,
                "buffered": true,
                "flushToDiskInterval": "00:00:05"
              }
            }
          ]
        }
      }
    }
  }
}
